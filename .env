# NoneBot 框架配置
# 配置 Nonebot 监听的端口。
PORT=8000
# 配置 Nonebot 监听的 IP / 主机名。
# 如果需要公网连接，请把此项改为 0.0.0.0。
HOST="127.0.0.1"
# 超级用户（拥有管理权限的用户的 QQ 号）。
# 请注意，QQ 号外须加上双引号（英文状态下的半角符号），两个号码间用逗号隔开。
SUPERUSERS=[]
# 配置 Nonebot 命令起始字符。
COMMAND_SEP=[" "]
COMMAND_START=["#", "/", "."]
# 日志输出等级，默认填写 INFO 即可。
LOG_LEVEL="INFO"

DRIVER=~fastapi

# ================ 适配器配置 ================
# 说明：以下配置项为各适配器预留，未安装的适配器配置不会被加载。
# 列表/对象类型的配置请使用 JSON 格式，并用双引号包裹整个值。

# ===== OneBot V11 适配器 =====
# 适用于 Lagrange.OneBot、NapCat、LLOneBot 等实现。
# OneBot 平台的 AccessToken，由 OneBot 服务端设置；未启用请留空。
ONEBOT_ACCESS_TOKEN=""

# ===== QQ 官方机器人适配器 =====
# QQ 开放平台机器人配置列表（JSON 数组），每项支持以下字段：
#   id             应用 AppID（开放平台获取）
#   token          应用 Token
#   secret         应用 Secret
#   intent         事件订阅，对象类型；可选字段如 guilds/guild_members/guild_messages/
#                  guild_message_reactions/direct_message/c2c_group_at_messages/
#                  interaction/message_audit/at_messages 等，默认值见官方文档
#   use_websocket  是否使用 WebSocket 连接，默认 True；False 时使用 WebHook（需公网）
QQ_BOTS=[]
# 是否启用沙盒模式（不影响列表配置，独立环境变量），默认 false。
QQ_IS_SANDBOX=false

# ===== Telegram 适配器 =====
# Telegram 机器人配置列表（JSON 数组），每项支持以下字段：
#   token       向 @BotFather 申请的机器人 Token（必填）
#   is_webhook  是否启用 Webhook 模式，默认 false（即默认 Long polling 模式）
TELEGRAM_BOTS=[]
# Webhook 模式下使用的公网 HTTPS 地址，例如 https://yourdomain.com；Long polling 模式下留空。
TELEGRAM_WEBHOOK_URL=""
# 访问 Telegram API 的代理地址，例如 http://127.0.0.1:10809；Socks 协议需安装 httpx[socks]。
TELEGRAM_PROXY=""

# ===== Discord 适配器 =====
# Discord 机器人配置列表（JSON 数组），每项支持以下字段：
#   token               机器人 Token（必填）
#   intent              事件订阅，对象类型；常用字段：guild_messages、direct_messages、
#                       message_content（特权 Intent，需在 Developer Portal 开启）
#   application_commands 斜杠命令注册范围；{"*": ["*"]} 注册全部为全局命令，
#                       {"命令名": ["服务器ID"]} 注册为指定服务器的局部命令
DISCORD_BOTS=[]
# Discord API 版本，默认 10。
DISCORD_API_VERSION=10
# Discord API 超时时间（秒），默认 30。
DISCORD_API_TIMEOUT=30
# 是否启用网关数据压缩，默认 false。
DISCORD_COMPRESS=false
# 是否处理自己发送的消息，默认 false。
DISCORD_HANDLE_SELF_MESSAGE=false
# 访问 Discord API 的代理地址，例如 http://127.0.0.1:6666；不使用请留空。
DISCORD_PROXY=""

# ===== DoDo 适配器 =====
# DoDo 开放平台机器人配置列表（JSON 数组，仅支持 WebSocket 连接），每项支持以下字段：
#   client_id  开放平台获取的客户端 ID（必填）
#   token      开放平台获取的客户端 Token（必填）
DODO_BOTS=[]

# ===== KOOK（开黑啦）适配器 =====
# KOOK 机器人配置列表（JSON 数组），每项支持以下字段：
#   token  在开发者平台 - 我的应用 - 机器人页面获取的 Token（必填）
KAIHEILA_BOTS=[]

# ===== Satori 适配器 =====
# Satori 客户端列表（JSON 数组），每项支持以下字段：
#   host    Satori 服务端监听地址，例如 localhost（必填）
#   port    Satori 服务端监听端口，例如 5500（必填）
#   path    Satori 服务端自定义监听路径，例如 /satori，默认空字符串
#   token   连接令牌，由服务端决定是否需要（如对接 Chronocat 必填）
#   timeout 连接超时时间（秒），默认 30
#   secure  是否使用 TLS 加密连接，默认 false
SATORI_CLIENTS=[]

# ===== Minecraft 适配器 =====
# 建议使用反向 WebSocket Client
# 使用 nonebot-adapter-minecraft 连接 Minecraft 服务器（鹊桥 / QueQiao 插件）。
# 格式为：{"服务器名称": ["ws://地址:端口/路径"]}
# 如果连接多个服务器，可配置多个条目。
MINECRAFT_WS_URLS={}
# WebSocket 连接令牌（可选），如服务器端设置了访问令牌，需在此填写一致。
MINECRAFT_ACCESS_TOKEN=""

# 自定义配置已迁移至 config.toml
